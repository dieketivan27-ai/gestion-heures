NODE_ENV=production
PORT=8080

# ─────────────────────────────────────────────────────────────
# Base de données PostgreSQL (Render injecte DATABASE_URL)
# ─────────────────────────────────────────────────────────────
# Sur Render : DATABASE_URL est injectée automatiquement via render.yaml (fromDatabase)
# Format : postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=

# ─────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────
JWT_SECRET=         # Généré automatiquement par Render (generateValue: true)
JWT_EXPIRES_IN=30m

# ─────────────────────────────────────────────────────────────
# CORS — URL de votre frontend Vercel
# ─────────────────────────────────────────────────────────────
FRONTEND_URL=https://gestion-heures-gold.vercel.app

# ─────────────────────────────────────────────────────────────
# SMTP (Emails)
# ─────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM=GestionHeures <no-reply@gestionheures.com>
APP_URL=https://gestion-heures-gold.vercel.app
