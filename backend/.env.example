NODE_ENV=production
PORT=8080

# ─────────────────────────────────────────────────────────────
# Base de données PostgreSQL (Neon — base externe)
# ─────────────────────────────────────────────────────────────
# 1. Créer une base sur https://console.neon.tech
# 2. Copier la "Connection string" (format pooler recommandé)
# 3. La coller dans Render Dashboard → Service → Environment → DATABASE_URL
# Exemple factice :
DATABASE_URL=postgresql://user:password@ep-xxx-yyy.eu-central-1.aws.neon.tech/dbname?sslmode=require

# ─────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────
JWT_SECRET=         # Généré automatiquement par Render (generateValue: true)
JWT_EXPIRES_IN=30m

# ─────────────────────────────────────────────────────────────
# CORS — URL de votre frontend Vercel
# ─────────────────────────────────────────────────────────────
FRONTEND_URL=https://gestion-heures-gold.vercel.app

# ─────────────────────────────────────────────────────────────
# SMTP (Emails)
# ─────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM=GestionHeures <no-reply@gestionheures.com>
APP_URL=https://gestion-heures-gold.vercel.app
