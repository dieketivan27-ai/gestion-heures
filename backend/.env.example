NODE_ENV=production
PORT=3000

# Database : Option 1 (Recommandé sur Railway) : URL complète
MYSQL_URL=

# Database : Option 2 : Variables séparées (Railway injecte MYSQLHOST... ou DB_HOST...)
# MYSQLHOST=
# MYSQLPORT=3306
# MYSQLDATABASE=
# MYSQLUSER=
# MYSQLPASSWORD=
# Ou formats classiques :
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=30m

# URLs frontend (CORS et emails)
FRONTEND_URL=https://VOTRE_APP.vercel.app

# SMTP (Emails)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM=GestionHeures <no-reply@gestionheures.com>
APP_URL=https://VOTRE_APP.vercel.app
